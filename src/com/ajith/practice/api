import java.net.http.HttpClient;
import java.net.URI;
import java.net.http.HttpRequest;

public class ApiPractice {
    public static void main(String[] args) {
    String myApikey = System.getenv("OPENAI_API_KEY");

        HttpClient client = HttpClient.newHttpClient();
        URI uri = URI.create("https://api.openai.com/v1/responses");

        String json = """
        {
          "model": "gpt-5",
          "input": "Say hello"
        }
        """;

   HttpRequest myRequest = HttpRequest.newBuilder()
                .uri(uri).header("Authorization: ","Bearer" + myApikey).header("Content-Type", "application/json")
                .POST(HttpRequest.BodyPublishers.ofString(json))
                .build();
    }
}